# Copia este archivo a ".env" (en la raiz del proyecto) y completa con los
# datos del proyecto de Supabase compartido "tiendas-web": Project Settings -> API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Identifica a esta tienda dentro de la base compartida (columna site_id).
# No cambiar salvo que este sitio pase a usar otro site_id.
VITE_SITE_ID=buonstile
